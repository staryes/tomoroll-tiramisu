---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="你所尋找的頁面不存在。" noindex>
  <section class="not-found">
    <div class="shell">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1>這一頁沒有滾到明天。</h1>
      <p class="not-found-copy">網址可能已變更，或這個頁面尚未存在。</p>
      <a class="button primary" href="/">回到首頁 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
