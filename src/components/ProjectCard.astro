---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, summary, cover, coverAlt, year, services } = project.data;
---

<article class="project-card">
  <a class="project-image-wrap" href={`/projects/${project.id}/`} aria-label={`查看 ${title} 專案`}>
    <img
      class="project-image"
      src={cover}
      alt={coverAlt}
      width="1200"
      height="800"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </a>
  <div class="project-card-content">
    <div class="project-meta">
      <span>{year}</span>
      <span>{services.join(' · ')}</span>
    </div>
    <h2><a href={`/projects/${project.id}/`}>{title}</a></h2>
    <p>{summary}</p>
    <a class="text-link" href={`/projects/${project.id}/`}>
      閱讀專案 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
