---
/**
 * The Tomoroll roll mark on its own, for tight spaces and the favicon.
 *
 * Extracted from the designer's artboards (webpage design/TOMORoll Website (1).svg).
 * fill is currentColor so the mark takes the surrounding text colour — the design
 * uses it in cream on olive, olive on pale pink, and white over photography.
 */
interface Props {
  /** Rendered width. Height follows from the aspect ratio. */
  width?: string;
  /** Set when the mark is decorative and an adjacent element already names the brand. */
  decorative?: boolean;
  class?: string;
}

const { width = '160px', decorative = false, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="195.03 262.20 456.08 437.52"
  width={width}
  fill="currentColor"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'Tomoroll'}
>
