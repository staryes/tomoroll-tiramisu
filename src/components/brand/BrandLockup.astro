  class={className}
  viewBox="195.03 262.20 752.96 519.65"
  width={width}
  fill="currentColor"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'Tomoroll'}
