---
import { navigation } from '../config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isActive = (href: string) =>
  href === '/projects' ? currentPath.startsWith('/projects') : currentPath === href;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Tomoroll 首頁">
      <svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true">
        <circle cx="18" cy="18" r="15" fill="currentColor"></circle>
        <path d="M10 18h16M18 10v16" stroke="#f5f0e8" stroke-width="3"></path>
      </svg>
      <span>Tomoroll</span>
    </a>

    <nav class="desktop-nav" aria-label="主要導覽">
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu">
      <summary aria-label="開啟導覽選單">
        <span></span><span></span>
      </summary>
      <nav aria-label="行動版導覽">
        {
          navigation.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
