---
import BrandMark from './brand/BrandMark.astro';
import { SITE, navigation } from '../config';
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const year = new Date().getFullYear();

// The Taiwan entity is still a preparatory office. Stated rather than omitted —
// see the note on SITE.registrationTWStatus.
const twLine =
  locale === 'zh-TW'
    ? `${SITE.legalNameTW}（籌備處）`
    : `${SITE.legalNameTW} (preparatory office)`;
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <a href={localizePath('/', locale)} aria-label={t('a11y.home')}>
        <BrandMark width="72px" />
      </a>

      <nav class="footer-nav" aria-label={t('nav.home')}>
        {
          navigation.map((item) => (
            <a href={`${localizePath(item.href, locale)}${item.hash}`}>{t(item.key)}</a>
          ))
        }
      </nav>

      <p>
        <a class="text-link" href={`mailto:${SITE.contactEmail}`}>
          {SITE.contactEmail}
        </a>
      </p>
    </div>

    <div class="footer-bottom">
      <p>
        {SITE.legalNameUS} · {SITE.registrationUS}<br />
        {twLine}
      </p>
      <p>© {year} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
