---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
}

const { member } = Astro.props;
const { name, role, photo, photoAlt, bio } = member.data;
---

<article class="member-card">
  {
    photo ? (
      <img src={photo} alt={photoAlt || `${name} 的個人照片`} width="640" height="760" loading="lazy" />
    ) : (
      <div class="member-placeholder" aria-hidden="true"><span>{name.slice(0, 1)}</span></div>
    )
  }
  <div class="member-content">
    <p class="member-role">{role}</p>
    <h2>{name}</h2>
    <p>{bio}</p>
  </div>
</article>
