---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { productsCopy } from '../../i18n/copy/pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = productsCopy[locale];
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={c.hero.title} description={c.hero.body?.[0]}>
  <section class="section bg-cream">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1 class="display">{c.hero.title}</h1>
      </div>
      {c.hero.body?.map((paragraph) => <p class="body lead">{paragraph}</p>)}
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  {/* Nothing is published yet, so the page states that plainly rather than
      showing an empty grid. The five lines are still listed — they are what a
      reader came to understand. */}
  <section class="section bg-pink">
    <div class="shell">
      <div class="empty-state">
        <h2 class="h2">{c.pendingTitle}</h2>
        <p class="body">{c.pendingBody}</p>
        <p class="grid-footer">
          <a class="text-link" href={`mailto:${SITE.contactEmail}`}>
            {t('cta.email')} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="shell">
      <div class="section-head">
        <h2 class="h2">{c.linesTitle}</h2>
      </div>
      <div class="tile-grid">
        {
          c.lines.map((line) => (
            <article class="tile">
              <h3 class="h3">{line}</h3>
              <p class="eyebrow">{t('label.inDevelopment')}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
