---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.published);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, cover, coverAlt, client, year, services } = project.data;
---

<BaseLayout title={title} description={summary} image={cover}>
  <article>
    <header class="project-detail-hero">
      <div class="shell">
        <p class="eyebrow"><span aria-hidden="true"></span>Project</p>
        <h1>{title}</h1>
        <p class="project-detail-summary">{summary}</p>
        <dl class="project-facts">
          <div><dt>Client</dt><dd>{client}</dd></div>
          <div><dt>Year</dt><dd>{year}</dd></div>
          <div><dt>Services</dt><dd>{services.join(' · ')}</dd></div>
        </dl>
      </div>
    </header>
    <figure class="project-cover">
      <img src={cover} alt={coverAlt} width="1200" height="800" fetchpriority="high" />
    </figure>
    <div class="prose"><Content /></div>
  </article>

  <section class="next-project">
    <div class="shell">
      <p>Keep moving forward</p>
      <a href="/projects">回到所有專案 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
